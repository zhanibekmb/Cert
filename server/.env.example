# Copy to .env and fill in. The server runs fine with NONE of these set
# (AI judge falls back to a mock, DB is a local sqlite file).
# server/index.js loads this file automatically (no dotenv dependency).

# Port the API listens on
PORT=8787

# Real AI judge — set this to use Gemini Vision instead of the mock
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Google Sign-In: OAuth 2.0 Web client ID (Google Cloud Console → Credentials).
# Public value — the SAME id must be set as window.GOOGLE_CLIENT_ID in app.html.
GOOGLE_CLIENT_ID=

# Where the SQLite file lives (default: ./cert.db)
CERT_DB=

# CORS: the origin your frontend is served from (default: allow all in dev)
# e.g. http://localhost:4321  or  https://cert.app
CORS_ORIGIN=
