{
  "expo": {
    "name": "Cert",
    "slug": "cert",
    "scheme": "cert",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#070608",
    "icon": "./assets/gladiator-logo.png",
    "splash": {
      "image": "./assets/gladiator-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#070608"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cert.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cert.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/gladiator-logo.png",
        "backgroundColor": "#F4EFE8"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cert needs the camera to take your daily proof photo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cert needs the camera to record your timelapse proof."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cert can attach your location to a proof so it is verified where it happened."
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "685bfa75-5f2f-454a-a276-0d5ce64f9ddc"
      }
    },
    "owner": "zhanibekm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/685bfa75-5f2f-454a-a276-0d5ce64f9ddc"
    }
  }
}
