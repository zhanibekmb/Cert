{
  "expo": {
    "name": "Cert",
    "slug": "cert",
    "scheme": "cert",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "backgroundColor": "#070608",
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/gladiator-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#070608"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cert.mobile",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.cert.mobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cert uses the camera so you can take your daily proof photo — for example, a shot at the gym to verify today's workout goal.",
          "photosPermission": "Cert accesses your photo library so you can choose a photo as your daily proof — for example, picking a photo of your run to verify today's goal."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cert needs the camera to take your daily proof photo."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cert can attach your location to a proof so it is verified where it happened."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Cert saves your certificate sticker to your photo library so you can layer it over your own photos."
        }
      ],
      "expo-asset",
      "expo-localization",
      "expo-web-browser",
      "expo-notifications",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "685bfa75-5f2f-454a-a276-0d5ce64f9ddc"
      }
    },
    "owner": "zhanibekm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/685bfa75-5f2f-454a-a276-0d5ce64f9ddc"
    }
  }
}
